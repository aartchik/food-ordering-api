{
  "openapi": "3.1.0",
  "info": {
    "title": "Food Ordering API API",
    "version": "1.0.0",
    "description": "API for customer ordering flows and restaurant integrations. Monetary values are integer kopecks."
  },
  "servers": [{"url": "http://localhost:8080"}],
  "tags": [
    {"name": "System"},
    {"name": "Catalog"},
    {"name": "Carts"},
    {"name": "Orders"},
    {"name": "Partner"}
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": ["System"],
        "operationId": "healthcheck",
        "responses": {"200": {"description": "Service is available", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}}}
      }
    },
    "/v1/restaurants": {
      "get": {
        "tags": ["Catalog"],
        "operationId": "listRestaurants",
        "parameters": [
          {"$ref": "#/components/parameters/Page"},
          {"$ref": "#/components/parameters/PageSize"},
          {"name": "q", "in": "query", "schema": {"type": "string", "maxLength": 120}},
          {"name": "only_open", "in": "query", "schema": {"type": "boolean", "default": false}},
          {"name": "sort", "in": "query", "schema": {"type": "string", "default": "id", "enum": ["id", "-id", "name", "-name", "created_at", "-created_at"]}}
        ],
        "responses": {
          "200": {"description": "Restaurant page", "content": {"application/json": {"schema": {"type": "object", "required": ["restaurants", "metadata"], "properties": {"restaurants": {"type": "array", "items": {"$ref": "#/components/schemas/Restaurant"}}, "metadata": {"$ref": "#/components/schemas/Metadata"}}}}}},
          "422": {"$ref": "#/components/responses/ValidationError"}
        }
      }
    },
    "/v1/restaurants/{id}": {
      "get": {
        "tags": ["Catalog"], "operationId": "getRestaurant", "parameters": [{"$ref": "#/components/parameters/ID"}],
        "responses": {"200": {"description": "Restaurant", "content": {"application/json": {"schema": {"type": "object", "required": ["restaurant"], "properties": {"restaurant": {"$ref": "#/components/schemas/Restaurant"}}}}}}, "404": {"$ref": "#/components/responses/NotFound"}}
      }
    },
    "/v1/restaurants/{id}/menu": {
      "get": {
        "tags": ["Catalog"], "operationId": "listMenu", "parameters": [{"$ref": "#/components/parameters/ID"}, {"name": "available_only", "in": "query", "schema": {"type": "boolean", "default": false}}],
        "responses": {"200": {"description": "Menu", "content": {"application/json": {"schema": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/MenuItem"}}}}}}}, "404": {"$ref": "#/components/responses/NotFound"}, "422": {"$ref": "#/components/responses/ValidationError"}}
      }
    },
    "/v1/carts": {
      "post": {
        "tags": ["Carts"], "operationId": "createCart",
        "responses": {"201": {"description": "Cart created", "headers": {"Location": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CartView"}}}}}
      }
    },
    "/v1/carts/{id}": {
      "get": {
        "tags": ["Carts"], "operationId": "getCart", "parameters": [{"$ref": "#/components/parameters/ID"}],
        "responses": {"200": {"description": "Cart", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CartView"}}}}, "404": {"$ref": "#/components/responses/NotFound"}}
      }
    },
    "/v1/carts/{id}/items": {
      "post": {
        "tags": ["Carts"], "operationId": "addCartItem", "parameters": [{"$ref": "#/components/parameters/ID"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CartItemInput"}}}},
        "responses": {"200": {"description": "Updated cart", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CartView"}}}}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/ValidationError"}}
      }
    },
    "/v1/carts/{id}/items/{item_id}": {
      "patch": {
        "tags": ["Carts"], "operationId": "updateCartItem", "parameters": [{"$ref": "#/components/parameters/ID"}, {"$ref": "#/components/parameters/ItemID"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["quantity"], "properties": {"quantity": {"type": "integer", "minimum": 1, "maximum": 99}}, "additionalProperties": false}}}},
        "responses": {"200": {"description": "Updated cart", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CartView"}}}}, "404": {"$ref": "#/components/responses/NotFound"}, "422": {"$ref": "#/components/responses/ValidationError"}}
      },
      "delete": {
        "tags": ["Carts"], "operationId": "deleteCartItem", "parameters": [{"$ref": "#/components/parameters/ID"}, {"$ref": "#/components/parameters/ItemID"}],
        "responses": {"200": {"description": "Updated cart", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CartView"}}}}, "404": {"$ref": "#/components/responses/NotFound"}}
      }
    },
    "/v1/orders": {
      "post": {
        "tags": ["Orders"], "operationId": "createOrder",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckoutInput"}}}},
        "responses": {"201": {"description": "Order created or idempotently replayed", "headers": {"Location": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderView"}}}}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/ValidationError"}}
      }
    },
    "/v1/orders/{id}": {
      "get": {
        "tags": ["Orders"], "operationId": "getOrder", "parameters": [{"$ref": "#/components/parameters/ID"}],
        "responses": {"200": {"description": "Order", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderView"}}}}, "404": {"$ref": "#/components/responses/NotFound"}}
      }
    },
    "/v1/partner/catalog": {
      "put": {
        "tags": ["Partner"], "operationId": "syncPartnerCatalog", "security": [{"partnerBearer": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CatalogInput"}}}},
        "responses": {"200": {"description": "Synchronized catalog", "content": {"application/json": {"schema": {"type": "object", "required": ["restaurant", "items"], "properties": {"restaurant": {"$ref": "#/components/schemas/Restaurant"}, "items": {"type": "array", "items": {"$ref": "#/components/schemas/MenuItem"}}}}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "422": {"$ref": "#/components/responses/ValidationError"}}
      }
    },
    "/v1/partner/orders": {
      "get": {
        "tags": ["Partner"], "operationId": "listPartnerOrders", "security": [{"partnerBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/Page"}, {"$ref": "#/components/parameters/PageSize"}, {"name": "status", "in": "query", "schema": {"$ref": "#/components/schemas/OrderStatus"}}, {"name": "sort", "in": "query", "schema": {"type": "string", "default": "-created_at", "enum": ["created_at", "-created_at", "updated_at", "-updated_at", "status", "-status"]}}],
        "responses": {"200": {"description": "Partner order page", "content": {"application/json": {"schema": {"type": "object", "required": ["orders", "metadata"], "properties": {"orders": {"type": "array", "items": {"$ref": "#/components/schemas/OrderView"}}, "metadata": {"$ref": "#/components/schemas/Metadata"}}}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "422": {"$ref": "#/components/responses/ValidationError"}}
      }
    },
    "/v1/partner/orders/{id}": {
      "get": {
        "tags": ["Partner"], "operationId": "getPartnerOrder", "security": [{"partnerBearer": []}], "parameters": [{"$ref": "#/components/parameters/ID"}],
        "responses": {"200": {"description": "Partner order", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderView"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "404": {"$ref": "#/components/responses/NotFound"}}
      }
    },
    "/v1/partner/orders/{id}/status": {
      "patch": {
        "tags": ["Partner"], "operationId": "updatePartnerOrderStatus", "security": [{"partnerBearer": []}], "parameters": [{"$ref": "#/components/parameters/ID"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderStatusUpdate"}}}},
        "responses": {"200": {"description": "Updated order", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderView"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/ValidationError"}}
      }
    }
  },
  "components": {
    "securitySchemes": {"partnerBearer": {"type": "http", "scheme": "bearer", "description": "API key assigned to a restaurant partner"}},
    "parameters": {
      "ID": {"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "format": "int64", "minimum": 1}},
      "ItemID": {"name": "item_id", "in": "path", "required": true, "schema": {"type": "integer", "format": "int64", "minimum": 1}},
      "Page": {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 10000000, "default": 1}},
      "PageSize": {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}}
    },
    "responses": {
      "NotFound": {"description": "Resource not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Unauthorized": {"description": "Missing or invalid partner API key", "headers": {"WWW-Authenticate": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Conflict": {"description": "Business state conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "ValidationError": {"description": "Input validation failed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ValidationError"}}}}
    },
    "schemas": {
      "Health": {"type": "object", "required": ["status", "system", "env"], "properties": {"status": {"type": "string"}, "system": {"type": "string"}, "env": {"type": "string"}}},
      "Metadata": {"type": "object", "required": ["current_page", "page_size", "first_page", "last_page", "total_records"], "properties": {"current_page": {"type": "integer"}, "page_size": {"type": "integer"}, "first_page": {"type": "integer"}, "last_page": {"type": "integer"}, "total_records": {"type": "integer"}}},
      "RestaurantInput": {"type": "object", "required": ["name", "is_open"], "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 120}, "description": {"type": "string", "maxLength": 500}, "address": {"type": "string", "maxLength": 300}, "is_open": {"type": "boolean"}}},
      "Restaurant": {"allOf": [{"$ref": "#/components/schemas/RestaurantInput"}, {"type": "object", "required": ["id", "partner_id", "version", "created_at", "updated_at"], "properties": {"id": {"type": "integer", "format": "int64"}, "partner_id": {"type": "string"}, "version": {"type": "integer"}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}}}]},
      "MenuItemInput": {"type": "object", "additionalProperties": false, "required": ["partner_item_id", "name", "price_kopecks", "is_available", "preparation_min"], "properties": {"partner_item_id": {"type": "string", "minLength": 1, "maxLength": 120}, "name": {"type": "string", "minLength": 1, "maxLength": 120}, "description": {"type": "string", "maxLength": 500}, "price_kopecks": {"type": "integer", "minimum": 1}, "is_available": {"type": "boolean"}, "preparation_min": {"type": "integer", "minimum": 0, "maximum": 240}}},
      "MenuItem": {"allOf": [{"$ref": "#/components/schemas/MenuItemInput"}, {"type": "object", "required": ["id", "restaurant_id", "version", "created_at", "updated_at"], "properties": {"id": {"type": "integer", "format": "int64"}, "restaurant_id": {"type": "integer", "format": "int64"}, "version": {"type": "integer"}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}}}]},
      "CatalogInput": {"type": "object", "additionalProperties": false, "required": ["restaurant", "items"], "properties": {"restaurant": {"$ref": "#/components/schemas/RestaurantInput"}, "items": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/components/schemas/MenuItemInput"}}}},
      "Cart": {"type": "object", "required": ["id", "created_at", "updated_at"], "properties": {"id": {"type": "integer", "format": "int64"}, "user_id": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}}},
      "CartItemInput": {"type": "object", "additionalProperties": false, "required": ["menu_item_id", "quantity"], "properties": {"menu_item_id": {"type": "integer", "format": "int64", "minimum": 1}, "quantity": {"type": "integer", "minimum": 1, "maximum": 99}}},
      "CartItem": {"type": "object", "required": ["id", "cart_id", "menu_item_id", "quantity", "name", "price_kopecks", "created_at"], "properties": {"id": {"type": "integer", "format": "int64"}, "cart_id": {"type": "integer", "format": "int64"}, "menu_item_id": {"type": "integer", "format": "int64"}, "quantity": {"type": "integer"}, "name": {"type": "string"}, "price_kopecks": {"type": "integer"}, "created_at": {"type": "string", "format": "date-time"}}},
      "CartView": {"type": "object", "required": ["cart", "items", "total_kopecks"], "properties": {"cart": {"$ref": "#/components/schemas/Cart"}, "items": {"type": "array", "items": {"$ref": "#/components/schemas/CartItem"}}, "total_kopecks": {"type": "integer"}}},
      "Customer": {"type": "object", "additionalProperties": false, "required": ["name", "phone", "address"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 120}, "phone": {"type": "string", "minLength": 1, "maxLength": 32}, "address": {"type": "string", "minLength": 1, "maxLength": 300}, "comment": {"type": "string", "maxLength": 500}}},
      "CheckoutInput": {"type": "object", "additionalProperties": false, "required": ["cart_id", "customer", "idempotency_key"], "properties": {"cart_id": {"type": "integer", "format": "int64", "minimum": 1}, "customer": {"$ref": "#/components/schemas/Customer"}, "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 120}}},
      "OrderStatus": {"type": "string", "enum": ["pending_partner", "accepted", "cooking", "ready", "delivering", "delivered", "cancelled"]},
      "Order": {"type": "object", "required": ["id", "cart_id", "restaurant_id", "partner_id", "status", "customer", "total_kopecks", "version", "created_at", "updated_at"], "properties": {"id": {"type": "integer", "format": "int64"}, "cart_id": {"type": "integer", "format": "int64"}, "restaurant_id": {"type": "integer", "format": "int64"}, "partner_id": {"type": "string"}, "partner_order_id": {"type": "string"}, "status": {"$ref": "#/components/schemas/OrderStatus"}, "customer": {"$ref": "#/components/schemas/Customer"}, "total_kopecks": {"type": "integer"}, "idempotency_key": {"type": "string"}, "version": {"type": "integer"}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}}},
      "OrderItem": {"type": "object", "required": ["id", "order_id", "menu_item_id", "partner_item_id", "name", "quantity", "price_kopecks", "created_at"], "properties": {"id": {"type": "integer", "format": "int64"}, "order_id": {"type": "integer", "format": "int64"}, "menu_item_id": {"type": "integer", "format": "int64"}, "partner_item_id": {"type": "string"}, "name": {"type": "string"}, "quantity": {"type": "integer"}, "price_kopecks": {"type": "integer"}, "created_at": {"type": "string", "format": "date-time"}}},
      "OrderView": {"type": "object", "required": ["order", "items"], "properties": {"order": {"$ref": "#/components/schemas/Order"}, "items": {"type": "array", "items": {"$ref": "#/components/schemas/OrderItem"}}}},
      "OrderStatusUpdate": {"type": "object", "additionalProperties": false, "required": ["status", "version"], "properties": {"status": {"$ref": "#/components/schemas/OrderStatus"}, "partner_order_id": {"type": "string", "maxLength": 120}, "version": {"type": "integer", "minimum": 1}}},
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "string"}}},
      "ValidationError": {"type": "object", "required": ["error"], "properties": {"error": {"type": "object", "additionalProperties": {"type": "string"}}}}
    }
  }
}
