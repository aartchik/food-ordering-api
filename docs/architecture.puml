@startuml architecture
title API платформы заказа еды - диаграмма контейнеров C4

skinparam shadowing false
skinparam roundcorner 8
skinparam defaultTextAlignment center
skinparam rectangle {
  BackgroundColor #F7F7F7
  BorderColor #555555
}
skinparam database {
  BackgroundColor #E8F3EC
  BorderColor #41734F
}

actor "Пользователь" as user
actor "Сотрудник\nзаведения" as partner

rectangle "Веб-клиент\n[вне первой версии]" as web
rectangle "Food Ordering API\n[Go, net/http]\nПользовательское и партнерское API" as api
rectangle "Демо-ресторан\n[Go, отдельный сервис]\nСинхронизация каталога и обработка заказов" as restaurant
rectangle "Система наблюдения\n[вне проекта]\nСбор и хранение метрик" as monitoring
database "PostgreSQL\nИсточник истины" as postgres
database "Redis\nКэш меню на пять минут" as redis

user --> web : выбирает блюда,\nоформляет и отслеживает заказ
web --> api : HTTP/JSON
partner --> restaurant : управляет интеграцией
restaurant --> api : Партнерское HTTP API\nключ по схеме Bearer
monitoring --> api : GET /metrics\nформат Prometheus
api --> postgres : SQL, транзакции,\nблокировки
api --> redis : чтение, запись и\nочистка кэша

note right of api
  Обработчики по предметным областям
  Узкие интерфейсы в местах использования
  Промежуточные обработчики: перехват паники,
  идентификатор и журнал запроса,
  ограничение частоты, защитные заголовки
end note

note bottom of redis
  Не является источником истины.
  При ошибке данные читаются из PostgreSQL.
end note

@enduml
