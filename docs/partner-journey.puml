@startuml partner_journey
title CJM заведения платформа.Кухни

skinparam shadowing false
skinparam activity {
  BackgroundColor #F7F7F7
  BorderColor #555555
  DiamondBackgroundColor #FFF4D6
  DiamondBorderColor #8A6D1D
}

start
:Получить partner_id и ключ API по схеме Bearer;
:Подготовить карточку и полное меню;
:PUT /v1/partner/catalog;
if (Авторизация и каталог валидны?) then (да)
  :Каталог атомарно сохранен;
  :Кеш меню инвалидирован;
else (нет)
  :Исправить учетные данные или каталог;
  stop
endif

repeat
  :Получить свои pending_partner заказы;
  if (Заказ можно выполнить?) then (да)
    :Принять заказ и сохранить partner_order_id;
    :Передать accepted;
    :Передать cooking;
    :Передать ready;
    :Передать delivering;
    :Передать delivered;
  else (нет)
    :Передать cancelled;
  endif

  if (Получен конфликт версий?) then (да)
    :Повторно получить заказ;
    :Принять решение по актуальному статусу;
  else (нет)
  endif
repeat while (Есть новые заказы?) is (да) not (нет)

stop

@enduml
